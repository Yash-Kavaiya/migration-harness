# ── TrueForge harness ────────────────────────────────────────────────────────
# Local TrueForge server (npx @truefoundry/trueforge → http://localhost:8790)
TRUEFORGE_BASE_URL=http://localhost:8790
# Optional bearer if you enabled OIDC on the TrueForge server (no-auth by default)
TRUEFORGE_API_KEY=
# Model FQN applied to all 7 agents by `npm run sync-agents` (overrides agents/*.json).
# Must match a model configured in Settings → Models on the TrueForge server.
MH_AGENT_MODEL=anthropic/claude-sonnet-4-6

# ── GitHub MCP tokens (TWO distinct tokens — never reuse) ─────────────────────
# Read-only classic/fine-grained PAT: contents:read on the SOURCE repo only.
GITHUB_READ_TOKEN=
# Fine-grained PAT scoped to the CANONICAL repo only: contents:write, pull_requests:write.
GITHUB_WRITE_TOKEN=

# Source repo the migration reads (owner/name) and the path to the .NET service.
MH_SOURCE_REPO=your-org/orderpricing-legacy
MH_SOURCE_PATH=src/OrderPricing.Api
# Canonical repo the licensed cutover writes a branch + PR to.
MH_TARGET_REPO=your-org/orderpricing-legacy
MH_TARGET_BRANCH=main

# ── Sandbox (configured in the TrueForge UI, not here) ───────────────────────
# Settings → Sandbox providers → Daytona. Key needs: Sandboxes access + Snapshots write.
# This var is only a reminder that the key lives in TrueForge, not in this repo.
DAYTONA_KEY_LOCATION=trueforge-ui

# ── Orchestrator ────────────────────────────────────────────────────────────
ORCH_PORT=8080
ORCH_DB=./apps/orchestrator/data/mh.sqlite
WEB_ORIGIN=http://localhost:3000

# ── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ORCH_URL=http://localhost:8080
NEXT_PUBLIC_TRUEFORGE_URL=http://localhost:8790
