{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migrationharness.dev/schemas/architecture.schema.json",
  "title": "Architecture",
  "description": "Output of mh-architect: a static map of the .NET service under migration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["migrationId", "sourceRepo", "sourceCommit", "sourcePath", "entrypoint", "endpoints", "components"],
  "properties": {
    "migrationId": { "type": "string", "pattern": "^MH-[0-9]{4}$" },
    "sourceRepo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "sourcePath": { "type": "string", "minLength": 1 },
    "entrypoint": { "type": "string", "minLength": 1 },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "route"],
        "properties": {
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "route": { "type": "string", "pattern": "^/" },
          "requestDto": { "type": ["string", "null"] },
          "responseDto": { "type": ["string", "null"] },
          "handler": { "type": "string" }
        }
      }
    },
    "domainServices": { "type": "array", "items": { "type": "string" } },
    "validators": { "type": "array", "items": { "type": "string" } },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "kind": { "type": "string", "enum": ["nuget", "framework", "project"] }
        }
      }
    },
    "tests": { "type": "array", "items": { "type": "string" } },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "riskClass"],
        "properties": {
          "name": { "type": "string" },
          "riskClass": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
          "reason": { "type": "string" }
        }
      }
    },
    "unsupported": {
      "type": "array",
      "description": "Components with no safe automatic Rust mapping. Non-empty = migration halts.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "reason"],
        "properties": {
          "component": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
