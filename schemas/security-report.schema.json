{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migrationharness.dev/schemas/security-report.schema.json",
  "title": "SecurityReport",
  "description": "Output of mh-security: automated security-parity checks. Not a proof of security.",
  "type": "object",
  "additionalProperties": false,
  "required": ["migrationId", "checks", "newHighSeverity"],
  "properties": {
    "migrationId": { "type": "string", "pattern": "^MH-[0-9]{4}$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "input-validation-parity",
              "error-sanitization",
              "secret-leakage",
              "cargo-audit",
              "sensitive-logging"
            ]
          },
          "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
          "detail": { "type": "string" }
        }
      }
    },
    "newHighSeverity": { "type": "integer", "minimum": 0 }
  }
}
