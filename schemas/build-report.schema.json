{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migrationharness.dev/schemas/build-report.schema.json",
  "title": "BuildReport",
  "description": "Output of mh-migrator (and mh-repair): the result of compiling and testing the generated Rust service in the sandbox, plus the per-file hash tree the manifest binds to.",
  "type": "object",
  "additionalProperties": false,
  "required": ["migrationId", "cargoCheck", "cargoTest", "clippy", "rustTree"],
  "properties": {
    "migrationId": { "type": "string", "pattern": "^MH-[0-9]{4}$" },
    "cargoCheck": { "type": "string", "enum": ["PASS", "FAIL"] },
    "cargoTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "clippy": { "type": "string", "enum": ["PASS", "FAIL"] },
    "rustTree": {
      "type": "array",
      "description": "Every generated source file, as { path, sha256 } of the file bytes. Order-independent; hashed by the orchestrator into rustTreeSha256.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
